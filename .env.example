# ─── BidSentry Environment Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your real values.
# The .env file is git-ignored and must never be committed.
#
#   cp .env.example .env
#

# ── Composio ──────────────────────────────────────────────────────────────────
# Your Composio API key from https://app.composio.dev/settings
# Required for live Google Docs / Calendar / Gmail dispatch.
# Without this key, BidSentry runs in simulation mode (safe fallback).
COMPOSIO_API_KEY=your_composio_api_key_here

# ── Langflow ──────────────────────────────────────────────────────────────────
# Base URL of the Langflow server (must match --host/--port in "langflow run").
LANGFLOW_HOST=http://localhost:7860

# ── Bridge server ─────────────────────────────────────────────────────────────
# Port for server.py (frontend + /api/dispatch proxy).
PORT=8000

# ── Optional: AI model providers ─────────────────────────────────────────────
# Uncomment and fill in the provider you use inside Langflow.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...
