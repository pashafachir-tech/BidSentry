# Copy to .env. Keep credentials out of Git and screenshots.
HOST=127.0.0.1
PORT=8000
MAX_REQUEST_BYTES=12582912
AUDIT_LOG_PATH=audit_log.jsonl

# Async audit jobs. Use postgresql+asyncpg://... for a shared production DB.
DATABASE_URL=sqlite+aiosqlite:///./bidsentry_jobs.db
REDIS_URL=redis://127.0.0.1:6379/0
AUDIT_QUEUE_NAME=bidsentry:audit
AUDIT_JOB_TIMEOUT_SECONDS=900
AUDIT_JOB_RESULT_TTL_SECONDS=86400
DATABASE_ECHO=false

# Optional Langflow advisory. Local rules remain primary; external analysis is
# only called when both LANGFLOW_ENABLED and the per-audit consent checkbox are on.
LANGFLOW_ENABLED=false
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
LANGFLOW_APPLICATION_TOKEN=
LANGFLOW_TIMEOUT_SECONDS=30

# Optional direct structured extraction provider (IBM watsonx.ai).
# Ekstraksi kutipan lewat IBM watsonx.ai Chat API. Model dapat diganti dengan model chat apa pun
# yang tersedia di region proyek watsonx Anda (scripts/verify_watsonx.py menampilkan daftarnya).
LLM_PROVIDER=watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=mistralai/mistral-small-3-1-24b-instruct-2503
LLM_API_KEY=

# Legacy Gemini credential aliases remain supported.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Composio workspace actions. Missing key leaves actions unavailable.
COMPOSIO_API_KEY=
# Composio v3.1 tool execution endpoint.
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1/tools/execute/{action}
COMPOSIO_USER_ID=default
COMPOSIO_TIMEOUT_SECONDS=30

# --- Login peran (Pokja vs Vendor) ---
# Kosongkan untuk demo lokal (host loopback): peran bisa dipilih tanpa PIN.
# Pada host non-lokal, peran tanpa PIN otomatis dinonaktifkan.
# Lima PIN salah dari klien yang sama mengunci peran itu selama 5 menit.
BIDSENTRY_POKJA_PIN=
BIDSENTRY_VENDOR_PIN=
# Rahasia penandatangan cookie sesi. Kosong = kunci acak disimpan di samping audit log.
BIDSENTRY_SESSION_SECRET=

# --- Asumsi unit economics (ditampilkan di UI; verifikasi sebelum presentasi) ---
# Harga resmi IBM watsonx.ai untuk Mistral Small 3.1 (dicek 8 Nov 2026).
AI_PRICE_USD_PER_1M_INPUT_TOKENS=0.106
AI_PRICE_USD_PER_1M_OUTPUT_TOKENS=0.318
USD_IDR_RATE=16500
MANUAL_REVIEW_HOURS_PER_PACKAGE=12
MANUAL_HOURLY_COST_IDR=75000

# --- Mesin job asinkron (opsional, butuh requirements-jobs.txt) ---
# Isi 'redis' untuk mengaktifkan /api/v1/audit/jobs. UI web tidak memerlukannya.
BIDSENTRY_JOB_ENGINE=
REDIS_URL=redis://localhost:6379/0
